# /etc/agenthub/backend.env — non-secret settings for the API container.
# Placeholders only. The API holds no provider keys and runs no work: the
# worker (worker.env) does both.
#
# Secrets come from files in /etc/agenthub/secrets/, mounted at /run/secrets:
#   database_url   postgresql+asyncpg://agenthub:<password>@<host>:5432/agenthub
#                  (bundled-db: host `postgres`)
#   metrics_token  a long random value, shared with Prometheus and the worker
#   postgres_password  bundled-db only

SESSION_LIFETIME_MINUTES=720
SESSION_IDLE_TIMEOUT_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_WINDOW_MINUTES=15
WRITE_REQUESTS_PER_MINUTE=120

METRICS_ENABLED=true
# OTLP/HTTP traces endpoint, e.g. http://otel-collector:4318/v1/traces. Empty: not exported.
OTLP_ENDPOINT=

# Shown on Settings → Runtime; must match the worker's values.
REQUIRE_SANDBOX=true
MODEL_ROUTE_FAST_SMALL=anthropic:claude-haiku-4-5
MODEL_ROUTE_BALANCED_LARGE=anthropic:claude-sonnet-5
MODEL_ROUTE_REASONING_LARGE=anthropic:claude-opus-5
MODEL_DAILY_TOKEN_LIMIT_PER_ORG=2000000
