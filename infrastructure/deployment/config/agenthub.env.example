# /etc/agenthub/agenthub.env — host-level settings read by compose.
# Placeholders only. Copy to /etc/agenthub/agenthub.env and edit.
# Secrets never go in this file: see /etc/agenthub/secrets/ (docs/DEPLOYMENT.md).

# The public host name. Caddy obtains its certificate automatically.
AGENTHUB_SITE=agenthub.example.com
# Contact address for the certificate authority (expiry notices).
ACME_EMAIL=ops@example.com

# Empty for a managed PostgreSQL (recommended). `bundled-db` runs PostgreSQL
# in compose instead, published on 127.0.0.1:5432 only.
COMPOSE_PROFILES=

# Which environment this host is. Used in logs and the deploy record.
AGENTHUB_ENVIRONMENT_NAME=production
