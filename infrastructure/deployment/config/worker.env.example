# /etc/agenthub/worker.env — non-secret settings for the host-installed worker
# (agenthub-worker.service). Placeholders only.
#
# Secrets come from files in /etc/agenthub/worker/secrets/ (SECRETS_DIR):
#   database_url                postgresql+asyncpg://...  (bundled-db: host 127.0.0.1)
#   metrics_token               the same value as the API's
#   AGENTHUB_ANTHROPIC_API_KEY  optional; the worker is the only process holding it
#   AGENTHUB_OPENAI_API_KEY     optional

ENVIRONMENT=production
SECRETS_DIR=/etc/agenthub/worker/secrets

# The sandbox runtime: rootless Docker running as agenthub-sandbox, reached
# through its socket. The worker account is in that account's group; no
# container ever receives this socket.
SANDBOX_ENABLED=true
SANDBOX_COMMAND=docker
DOCKER_HOST=unix:///srv/agenthub-sandbox/run/docker.sock
REQUIRE_SANDBOX=true
# SANDBOX_IMAGE is written per release by the deploy script (release.env for
# the worker), always by digest. Do not set it here.

# Metrics on the compose outbound network's gateway, scraped by Prometheus.
WORKER_METRICS_HOST=172.30.2.1
WORKER_METRICS_PORT=9464

MODELS_ENABLED=true
MODEL_ROUTE_FAST_SMALL=anthropic:claude-haiku-4-5
MODEL_ROUTE_BALANCED_LARGE=anthropic:claude-sonnet-5
MODEL_ROUTE_REASONING_LARGE=anthropic:claude-opus-5
MODEL_REQUESTS_PER_MINUTE_PER_ORG=30
MODEL_DAILY_TOKEN_LIMIT_PER_ORG=2000000

EGRESS_ENABLED=true
ALERT_INTERVAL_SECONDS=60
# Optional HTTPS webhook for new alerts (metadata only).
ALERT_WEBHOOK_URL=
OTLP_ENDPOINT=
