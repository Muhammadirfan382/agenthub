# =============================================================================
# AgentHub environment configuration — PLACEHOLDERS ONLY
#
# Copy this file to `.env` in the repository root for local development and
# fill in values on your machine. `.env` is git-ignored and must never be
# committed. Never paste real credentials into this example file.
#
# The backend reads `.env` from the repository root. The frontend does NOT read
# this file: browser code must never receive server secrets.
# =============================================================================

# --- Backend ----------------------------------------------------------------
# One of: development, test, production.
# When unset the backend assumes `production`, which disables the API docs and
# requires DATABASE_URL to be set explicitly.
ENVIRONMENT=development

# --- Database (Phase 2) ------------------------------------------------------
# SQLAlchemy async URL. Leave empty in development to use a local SQLite file
# (agenthub-dev.db); set it to PostgreSQL to match staging and production.
# With the bundled Compose file:
#   postgresql+asyncpg://agenthub:agenthub_local_dev@127.0.0.1:5432/agenthub
DATABASE_URL=

# Log every SQL statement. Development only; noisy and may reveal data.
DB_ECHO=false

# --- Sessions and sign-in (Phase 3) -----------------------------------------
# A session ends at whichever comes first: the absolute lifetime, or this long
# without being used.
SESSION_LIFETIME_MINUTES=720
SESSION_IDLE_TIMEOUT_MINUTES=60

# Failed sign-ins allowed per account, and per client address, within the
# window. Enforced per process; a multi-worker deployment needs a shared store.
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=20
LOGIN_WINDOW_MINUTES=15

# scrypt work factor for new passwords (n = 2 ** exponent). Higher is slower
# and stronger. Production refuses anything below 14.
PASSWORD_HASH_COST_EXPONENT=15

# --- Runtime (Phase 5) -------------------------------------------------------
# Run the execution worker inside the API process. Set to false when running
# `python -m app.runtime.worker` as its own process.
RUNTIME_WORKER_ENABLED=true

# --- Model gateway (Phase 7) -------------------------------------------------
# Leave a key empty to leave that provider off; runs are then simulated.
# Namespaced on purpose: a plain ANTHROPIC_API_KEY / OPENAI_API_KEY set for other
# tools on this machine is never picked up.
# Server-side only: never exposed to the frontend or passed into sandboxes.
AGENTHUB_ANTHROPIC_API_KEY=
AGENTHUB_OPENAI_API_KEY=
MODELS_ENABLED=true
# Which model answers each agent tier, as provider:model.
MODEL_ROUTE_FAST_SMALL=anthropic:claude-haiku-4-5
MODEL_ROUTE_BALANCED_LARGE=anthropic:claude-sonnet-5
MODEL_ROUTE_REASONING_LARGE=anthropic:claude-opus-5
MODEL_REQUEST_TIMEOUT_SECONDS=180
MODEL_MAX_TURNS=8
MODEL_REQUESTS_PER_MINUTE_PER_ORG=30
MODEL_DAILY_TOKEN_LIMIT_PER_ORG=2000000

# --- Security (Phase 8) ------------------------------------------------------
# Let `api_request` run: an HTTPS GET to the agent's allowed domains, through
# the SSRF-safe egress gateway. false records every tool as not executed.
EGRESS_ENABLED=true
EGRESS_MAX_TOOL_OUTPUT_CHARS=20000
# State-changing requests per client per minute (per process).
WRITE_REQUESTS_PER_MINUTE=120
# Optional: a directory of files named after settings, e.g. a Docker or
# Kubernetes secret mount. Environment variables still take precedence.
SECRETS_DIR=

# --- Monitoring (Phase 9) ----------------------------------------------------
# Prometheus scrape endpoint at /api/v1/metrics. Production refuses to start
# with metrics on and no token. Scrape with "Authorization: Bearer <token>".
METRICS_ENABLED=true
# Generate a long random value locally; never commit one.
METRICS_TOKEN=
# OpenTelemetry OTLP/HTTP traces endpoint, e.g. http://otel-collector:4318/v1/traces.
# Empty: spans are created for log correlation but not exported.
OTLP_ENDPOINT=
# How often the worker evaluates alert rules, and their thresholds.
ALERT_INTERVAL_SECONDS=60
ALERT_FAILED_RUNS=3
ALERT_POLICY_DENIALS=10
ALERT_STALLED_RUN_SECONDS=300
# Optional HTTPS webhook for newly firing alerts (metadata only). Sent through
# the egress gateway, so it must resolve to a public address.
ALERT_WEBHOOK_URL=
# The standalone worker's own /metrics endpoint (0 = off). Production sets it
# on an address only Prometheus can reach; see infrastructure/deployment.
WORKER_METRICS_PORT=0
WORKER_METRICS_HOST=127.0.0.1

# --- Sandbox (Phase 6) -------------------------------------------------------
# Each run is given an isolated container, checked from the inside before its
# first step. Build the image first:
#   docker build -t agenthub/sandbox:0.6.0 agents/sandbox
# Without a container runtime, runs are recorded as simulations.
SANDBOX_ENABLED=true
# The container CLI: docker, or anything compatible with its `run` arguments.
SANDBOX_COMMAND=docker
# Must carry a tag or digest.
SANDBOX_IMAGE=agenthub/sandbox:0.6.0
SANDBOX_MEMORY_MB=512
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=128
SANDBOX_TMPFS_MB=64
SANDBOX_TIMEOUT_SECONDS=60
# true: refuse any run that cannot get a verified container.
REQUIRE_SANDBOX=false

# --- Planned: cache / queue --------------------------------------------------
REDIS_URL=

# --- Planned: token signing --------------------------------------------------
# Not used yet: sessions are opaque random tokens stored in the database, so
# nothing is signed today. Generate long random values locally when a phase
# needs them, and never reuse them across environments.
SECRET_KEY=
JWT_SECRET=
