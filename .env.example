# =============================================================================
# AgentHub environment configuration — PLACEHOLDERS ONLY
#
# Copy this file to `.env` in the repository root for local development and
# fill in values on your machine. `.env` is git-ignored and must never be
# committed. Never paste real credentials into this example file.
#
# The backend reads `.env` from the repository root. The frontend does NOT read
# this file: browser code must never receive server secrets.
# =============================================================================

# --- Backend ----------------------------------------------------------------
# One of: development, test, production.
# When unset the backend assumes `production`, which disables the API docs and
# requires DATABASE_URL to be set explicitly.
ENVIRONMENT=development

# --- Database (Phase 2) ------------------------------------------------------
# SQLAlchemy async URL. Leave empty in development to use a local SQLite file
# (agenthub-dev.db); set it to PostgreSQL to match staging and production.
# With the bundled Compose file:
#   postgresql+asyncpg://agenthub:agenthub_local_dev@127.0.0.1:5432/agenthub
DATABASE_URL=

# Log every SQL statement. Development only; noisy and may reveal data.
DB_ECHO=false

# --- Planned: cache / queue --------------------------------------------------
REDIS_URL=

# --- Planned: authentication (Phase 3) ---------------------------------------
# Generate long random values locally. Never reuse them across environments.
SECRET_KEY=
JWT_SECRET=

# --- Planned: AI/LLM integration (Phase 7) -----------------------------------
# Server-side only. Never exposed to the frontend or passed into agent sandboxes.
LLM_API_KEY=
