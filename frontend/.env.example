# =============================================================================
# AgentHub frontend configuration — PUBLIC VALUES ONLY
#
# Everything prefixed with VITE_ is compiled into the browser bundle and is
# visible to anyone who loads the app. Never put secrets, API keys, tokens or
# credentials here.
#
# Copy to `.env.local` (git-ignored) to override locally.
# =============================================================================

# Base URL of the AgentHub backend API, without a trailing slash.
# Leave empty to use same-origin requests (the Vite dev server proxies /api to
# http://127.0.0.1:8000). Must be an http(s) URL when set.
VITE_API_BASE_URL=

# Which services the app starts with: `demo` (default) or `api`.
# `demo` answers everything from in-memory demonstration data. `api` reads
# agents and executions from the backend, which must be running. Users can also
# switch this at runtime in Settings -> API; that choice is stored per browser.
VITE_DATA_SOURCE=demo
